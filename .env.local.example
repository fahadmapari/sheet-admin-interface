# Google Sheets API - shared spreadsheet and automation-only service account
SPREADSHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# NextAuth.js (Google OAuth for user Sheet actions and admin sharing)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed email domains/addresses (comma-separated)
ALLOWED_EMAILS=user1@example.com,user2@example.com

# MongoDB (for assembly line feature)
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/sheet-admin
